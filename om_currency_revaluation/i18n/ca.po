#. module: om_currency_revaluation
#: model_terms:ir.ui.view,arch_db:om_currency_revaluation.res_config_settings_view_form
msgid ""
"Restate the open foreign currency balances at the rate of a chosen date: the"
"                                difference is posted on these accounts as an"
" unrealized gain or loss."
msgstr ""
"Reformula els saldos pendents en moneda estrangera al tipus d'una data "
"triada: la                                diferència es publica en aquests "
"comptes com a guany o pèrdua no realitzada."

#. module: om_currency_revaluation
